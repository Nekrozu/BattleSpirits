---
import '../styles/global.css';
import Card from '../components/Card.astro';
import cards from '../data/cards.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Battle Spirits DB</title>
  </head>
  <body class="bg-black text-white min-h-screen">
    
    <nav class="border-b border-zinc-800 p-6 bg-zinc-950/50 sticky top-0 backdrop-blur-md z-50">
      <div class="max-w-6xl mx-auto flex flex-col gap-4">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <h1 class="text-2xl font-black tracking-tighter italic">BATTLE SPIRITS <span class="text-red-600">DB</span></h1>
          <input type="text" id="searchBox" placeholder="Search by name or ID..." class="bg-zinc-900 border border-zinc-700 px-4 py-2 rounded-full w-full md:w-96 focus:outline-none focus:ring-2 focus:ring-red-600" />
        </div>
        
        <div class="flex gap-4 items-center">
          <select id="colorFilter" class="bg-zinc-900 border border-zinc-700 px-3 py-1.5 rounded text-sm focus:outline-none focus:ring-1 focus:ring-red-600 text-zinc-300">
            <option value="all">All Colors</option>
            <option value="red">Red</option>
            <option value="white">White</option>
            <option value="purple">Purple</option>
            <option value="green">Green</option>
            <option value="yellow">Yellow</option>
            <option value="blue">Blue</option>
          </select>

          <select id="setFilter" class="bg-zinc-900 border border-zinc-700 px-3 py-1.5 rounded text-sm focus:outline-none focus:ring-1 focus:ring-red-600 text-zinc-300">
            <option value="all">All Sets</option>
            <option value="26rsd01">26RSD01</option>
            <option value="26rsd02">26RSD02</option>
            <option value="26rsd03">26RSD03</option>
            <option value="26rsd04">26RSD04</option>
            <option value="26rsd05">26RSD05</option>
            <option value="26rsd06">26RSD06</option>
          </select>
        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto p-6">
      <div id="cardGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
        {cards.map((card) => (
          <div class="card-item" 
               data-name={card.name.toLowerCase()} 
               data-id={card.id.toLowerCase()}
               data-color={card.color.toLowerCase()}
               data-set={card.set ? card.set.toLowerCase() : 'unknown'}>
            <Card card={card} />
          </div>
        ))}
      </div>
    </main>

    <script>
      const searchBox = document.getElementById('searchBox');
      const colorFilter = document.getElementById('colorFilter');
      const setFilter = document.getElementById('setFilter');
      const cardItems = document.querySelectorAll('.card-item');

      function filterCards() {
        // Get what the user is currently searching/filtering for
        const term = searchBox.value.toLowerCase();
        const selectedColor = colorFilter.value;
        const selectedSet = setFilter.value;

        cardItems.forEach(item => {
          // Get the data hidden on the HTML element
          const name = item.getAttribute('data-name');
          const id = item.getAttribute('data-id');
          const color = item.getAttribute('data-color');
          const set = item.getAttribute('data-set');

          // Check if this card passes all three tests
          const matchesText = name.includes(term) || id.includes(term);
          const matchesColor = selectedColor === 'all' || color === selectedColor;
          const matchesSet = selectedSet === 'all' || set === selectedSet;

          // If it passes all tests, show it. Otherwise, hide it.
          if (matchesText && matchesColor && matchesSet) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      }

      // Tell the browser to run the filter function whenever ANY of the inputs change
      searchBox.addEventListener('input', filterCards);
      colorFilter.addEventListener('change', filterCards);
      setFilter.addEventListener('change', filterCards);
    </script>
  </body>
</html>