---
import '../styles/global.css';
import Card from '../components/Card.astro';
import cards from '../data/cards.js'; 
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Battle Spirits DB</title>
    <style>
      /* UPDATED: Looks for .effect-text now */
      #cardGrid.show-text .effect-text { display: block; }
    </style>
  </head>
  <body class="bg-black text-white min-h-screen">
    
    <nav class="border-b border-zinc-800 p-6 bg-zinc-950/50 sticky top-0 backdrop-blur-md z-50">
      <div class="max-w-6xl mx-auto flex flex-col gap-4">
        
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <h1 class="text-2xl font-black tracking-tighter italic">BATTLE SPIRITS <span class="text-red-600">DB</span></h1>
          <input type="text" id="searchBox" placeholder="Search by name or ID..." class="bg-zinc-900 border border-zinc-700 px-4 py-2 rounded-full w-full md:w-96 focus:outline-none focus:ring-2 focus:ring-red-600" />
        </div>
        
        <div class="flex flex-wrap gap-4 items-center">
          <select id="colorFilter" class="bg-zinc-900 border border-zinc-700 px-3 py-1.5 rounded text-sm text-zinc-300">
            <option value="all">All Colors</option>
            <option value="red">Red</option>
            <option value="purple">Purple</option>
            <option value="green">Green</option>
            <option value="white">White</option>
            <option value="yellow">Yellow</option>
            <option value="blue">Blue</option>
          </select>

          <select id="setFilter" class="bg-zinc-900 border border-zinc-700 px-3 py-1.5 rounded text-sm text-zinc-300">
            <option value="all">All Sets</option>
            <option value="26rsd01">26RSD01</option>
            <option value="26rsd02">26RSD02</option>
            <option value="26rsd03">26RSD03</option>
            <option value="26rsd04">26RSD04</option>
            <option value="26rsd05">26RSD05</option>
            <option value="26rsd06">26RSD06</option>
          </select>

          <button id="toggleTextBtn" class="bg-zinc-800 hover:bg-zinc-700 border border-zinc-600 px-3 py-1.5 rounded text-sm transition-colors ml-auto">
            Toggle Text View
          </button>
        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto p-6">
      <div id="cardGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
        {cards.map((card) => (
          <div class="card-item" 
               data-name={card.name.toLowerCase()} 
               data-id={card.id.toLowerCase()}
               data-color={card.color.toLowerCase()}
               data-set={card.set ? card.set.toLowerCase() : 'unknown'}
               data-effect={card.effect || "No effect text available."}> <Card card={card} />
          </div>
        ))}
      </div>
    </main>

    <div id="cardModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden flex justify-center items-center p-4">
      <div class="bg-zinc-900 border border-zinc-700 rounded-2xl max-w-3xl w-full flex flex-col md:flex-row overflow-hidden relative">
        <button id="closeModalBtn" class="absolute top-4 right-4 bg-red-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold hover:bg-red-500 z-10">&times;</button>
        
        <div class="w-full md:w-1/2 p-4 flex justify-center bg-zinc-950">
          <img id="modalImg" src="" alt="Card" class="max-h-[60vh] object-contain rounded-lg shadow-xl" />
        </div>
        
        <div class="w-full md:w-1/2 p-6 flex flex-col">
          <h2 id="modalName" class="text-2xl font-bold mb-1 text-white">Card Name</h2>
          <span id="modalId" class="text-sm font-mono text-zinc-400 mb-6 border-b border-zinc-700 pb-2">ID</span>
          
          <h3 class="text-red-500 font-bold text-xs uppercase tracking-wider mb-2">Card Effect</h3> <p id="modalEffect" class="text-zinc-200 text-sm md:text-base leading-relaxed whitespace-pre-line overflow-y-auto"> Effect text goes here.
          </p>
        </div>
      </div>
    </div>

    <script>
      // 1. Filter Logic
      const searchBox = document.getElementById('searchBox');
      const colorFilter = document.getElementById('colorFilter');
      const setFilter = document.getElementById('setFilter');
      const cardItems = document.querySelectorAll('.card-item');

      function filterCards() {
        const term = searchBox.value.toLowerCase();
        const selectedColor = colorFilter.value;
        const selectedSet = setFilter.value;

        cardItems.forEach(item => {
          const name = item.getAttribute('data-name');
          const id = item.getAttribute('data-id');
          const color = item.getAttribute('data-color');
          const set = item.getAttribute('data-set');

          const matchesText = name.includes(term) || id.includes(term);
          const matchesColor = selectedColor === 'all' || color === selectedColor;
          const matchesSet = selectedSet === 'all' || set === selectedSet;

          item.style.display = (matchesText && matchesColor && matchesSet) ? 'block' : 'none';
        });
      }

      searchBox.addEventListener('input', filterCards);
      colorFilter.addEventListener('change', filterCards);
      setFilter.addEventListener('change', filterCards);

      // 2. Text Toggle Logic
      const toggleTextBtn = document.getElementById('toggleTextBtn');
      const cardGrid = document.getElementById('cardGrid');

      toggleTextBtn.addEventListener('click', () => {
        cardGrid.classList.toggle('show-text');
      });

      // 3. Modal Click Logic
      const cardModal = document.getElementById('cardModal');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const modalImg = document.getElementById('modalImg');
      const modalName = document.getElementById('modalName');
      const modalId = document.getElementById('modalId');
      const modalEffect = document.getElementById('modalEffect'); // UPDATED VARIABLE

      cardItems.forEach(item => {
        item.addEventListener('click', () => {
          const imgElement = item.querySelector('img');
          const name = item.getAttribute('data-name');
          const id = item.getAttribute('data-id');
          const effect = item.getAttribute('data-effect'); // UPDATED VARIABLE

          modalImg.src = imgElement.src;
          modalName.textContent = name.toUpperCase();
          modalId.textContent = id.toUpperCase();
          modalEffect.textContent = effect; // UPDATED VARIABLE

          cardModal.classList.remove('hidden');
        });
      });

      closeModalBtn.addEventListener('click', () => {
        cardModal.classList.add('hidden');
      });

      cardModal.addEventListener('click', (e) => {
        if (e.target === cardModal) {
          cardModal.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>