---
const { card } = Astro.props;
const colorMap = {
  Red: 'border-red-600 shadow-red-900/20',
  Purple: 'border-purple-600 shadow-purple-900/20',
  Green: 'border-emerald-600 shadow-emerald-900/20',
  White: 'border-slate-300 shadow-slate-400/20',
  Yellow: 'border-yellow-500 shadow-yellow-700/20',
  Blue: 'border-blue-600 shadow-blue-900/20'
};
---

<div class={`group relative border-2 rounded-xl overflow-hidden bg-zinc-900 shadow-lg transition-transform hover:-translate-y-1 cursor-pointer ${colorMap[card.color] || 'border-zinc-700'}`}>
  
  <img src={`${import.meta.env.BASE_URL}${card.image}`} alt={card.name} class="w-full aspect-[3/4] object-cover" />
  
  <div class="p-3">
    <h3 class="text-white font-bold truncate">{card.name}</h3>
    <div class="flex justify-between items-center mt-2">
      <span class="text-xs text-zinc-400 font-mono">{card.id}</span>
      <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-zinc-800 text-white border border-zinc-700">
        Cost: {card.cost}
      </span>
    </div>

    <div class="effect-text hidden mt-3 pt-3 border-t border-zinc-700 text-xs text-zinc-300 whitespace-pre-line">
      {card.effect || "No effect text available."}
    </div>
  </div>
</div>